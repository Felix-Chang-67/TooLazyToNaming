{
  "name": "kedamono-ayakashi-lyric-video",
  "version": "1.0.0",
  "private": true,
  "description": "Kinetic-typography lyric video for KEDAMONO_AYAKASHI, rendered frame by frame with Skia (@napi-rs/canvas) and encoded with ffmpeg.",
  "scripts": {
    "fetch": "./scripts/fetch_materials.sh && ./scripts/fetch_fonts.sh",
    "analyze": "python3 -I src/analyze_audio.py materials/KEDAMONO_AYAKASHI_24bit_48kHz.wav build/analysis.json 60",
    "stills": "node src/render.mjs --stills",
    "render": "./scripts/render_video.sh",
    "cover": "node src/cover.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0"
  }
}
